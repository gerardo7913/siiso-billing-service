# Copy to .env (git-ignored) and fill in. Loaded by spring.config.import.

# siiso_business (migrated by siiso-business-db). This service's own MySQL user, created by
# siiso-business-db/scripts/create-service-users.sh.
BILLING_DB_URL=jdbc:mysql://127.0.0.1:3306/siiso_business?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
BILLING_DB_USERNAME=siiso_billing
BILLING_DB_PASSWORD=

# Legacy database (read-only). Leave LEGACY_DB_URL empty to run without it.
# Use a dedicated user with SELECT-only grants.
LEGACY_DB_URL=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# Public key of this installation's security-service (PEM, X.509). Required.
JWT_PUBLIC_KEY_LOCATION=file:/etc/siiso/keys/jwt-public.pem

# SERVER_PORT=8085
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Import the legacy rates (tarifa) as rate plans at startup (idempotent).
LEGACY_IMPORT_ENABLED=false



# Legacy writer (least privilege, INSERT/UPDATE only on the tables this service writes back).
LEGACY_WRITE_DB_USERNAME=siiso_bill_rw
LEGACY_WRITE_DB_PASSWORD=
